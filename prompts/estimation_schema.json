{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "technical_and_design_decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activity_id":          { "type": "string" },
          "activity_name":        { "type": "string" },
          "activity_description": { "type": "string" },
          "most_likely_effort":   { "type": "number", "exclusiveMinimum": 0 }
        },
        "required": ["activity_id", "activity_name", "activity_description", "most_likely_effort"]
      }
    },
    "reported_total": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "most_likely_effort": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["most_likely_effort"]
    }
  },
  "required": ["technical_and_design_decisions", "assumptions", "activities", "reported_total"]
}
